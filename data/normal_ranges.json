{
  "z_score_threshold": 2.5,
  "correlation_window_ticks": 30,
  "rolling_window_ticks": 60,
  "risk_weights": {
    "w_severity": 0.35,
    "w_trend": 0.25,
    "w_correlation": 0.20,
    "w_time": 0.10,
