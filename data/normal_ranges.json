    "packet_loss_pct":           { "min": 0.0,   "max": 2.0,   "subsystem": "comms",        "delta_max_per_tick": 0.05  },
    "radiation_level_mgy":       { "min": 0.1,   "max": 0.8,   "subsystem": "environment",  "delta_max_per_tick": 0.005 }
