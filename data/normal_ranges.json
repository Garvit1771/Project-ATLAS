    "thruster_1_temp_c":         { "min": 180.0, "max": 220.0, "subsystem": "propulsion",   "delta_max_per_tick": 0.60  },
    "thruster_2_temp_c":         { "min": 180.0, "max": 220.0, "subsystem": "propulsion",   "delta_max_per_tick": 0.60  },
    "thruster_2_vibration_hz":   { "min": 0.5,   "max": 2.0,   "subsystem": "propulsion",   "delta_max_per_tick": 0.05  },
    "thruster_2_efficiency_pct": { "min": 92.0,  "max": 98.0,  "subsystem": "propulsion",   "delta_max_per_tick": 0.20  },
